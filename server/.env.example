# Salin file ini menjadi ".env" di folder server, lalu isi nilainya.
# Jangan pernah commit file .env asli.

PORT=
NODE_ENV=development

DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=

# Minta nilai JWT_SECRET kepada ketua kelompok lewat chat pribadi.
JWT_SECRET=
# Sesi berakhir bila tidak aktif selama waktu ini (client memperpanjang selama pengguna aktif).
JWT_EXPIRES_IN=30m

# Kata sandi untuk semua akun uji yang dibuat "npm run seed" (minimal 8 karakter).
# Hanya untuk komputer lokal; isi sendiri, jangan dibagikan atau dipakai di server sungguhan.
SEED_PASSWORD=

# Login pintasan per peran di halaman Login, KHUSUS pengujian di komputer lokal.
# Isi "aktif" untuk menyalakan; kosongkan di server sungguhan. Tidak berfungsi bila NODE_ENV=production.
LOGIN_UJI=