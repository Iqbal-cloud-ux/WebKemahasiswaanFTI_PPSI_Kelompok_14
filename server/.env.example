# Salin file ini menjadi ".env" di folder server, lalu isi nilainya.
# Jangan pernah commit file .env asli.

PORT=
NODE_ENV=development

DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=

# Minta nilai JWT_SECRET kepada ketua kelompok lewat chat pribadi.
JWT_SECRET=
# Sesi berakhir bila tidak aktif selama waktu ini (client memperpanjang selama pengguna aktif).
JWT_EXPIRES_IN=30m

# Alamat client (halaman /verifikasi) yang dimuat di QR surat, tanpa garis miring di akhir.
# Kosong = http://localhost:5173 (hanya saat pengembangan). Wajib diisi bila NODE_ENV=production.
# Untuk memindai QR dari HP di jaringan yang sama, isi dengan IP laptop, misalnya http://192.168.1.10:5173.
# Surat yang sudah terbit tetap memuat alamat lama.
ALAMAT_VERIFIKASI=

# Alamat client yang boleh memanggil API dari alamat berbeda (dipisah koma), misalnya https://layanan.contoh.test.
# Biarkan kosong bila client memanggil API lewat alamat yang sama (proxy Vite saat pengembangan, atau reverse proxy).
CORS_ORIGIN=

# Kata sandi untuk semua akun uji yang dibuat "npm run seed" (minimal 8 karakter).
# Hanya untuk komputer lokal; isi sendiri, jangan dibagikan atau dipakai di server sungguhan.
SEED_PASSWORD=

# Login pintasan per peran di halaman Login, KHUSUS pengujian di komputer lokal.
# Isi "aktif" untuk menyalakan; kosongkan di server sungguhan. Tidak berfungsi bila NODE_ENV=production.
LOGIN_UJI=